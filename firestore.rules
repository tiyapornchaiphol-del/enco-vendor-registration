rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Public Announcements (read-only for all) ───
    match /announcements/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // ─── Vendor Categories (read-only) ───
    match /categories/{docId} {
      allow read: if true;
      allow create, update, delete: if isAdmin(request.auth.uid);
    }

    // ─── Submissions ───
    match /submissions/{docId} {
      // Vendor: read/write own submission
      allow read: if request.auth.uid == resource.data.vendorId;
      allow create: if request.auth.uid != null;
      allow update: if request.auth.uid == resource.data.vendorId &&
                       resource.data.status == 'draft';

      // Admin: full access
      allow read, update, delete: if isAdmin(request.auth.uid);

      // Document Request Subcollection
      match /docRequests/{reqId} {
        allow read: if request.auth.uid == get(/databases/$(database)/documents/submissions/$(docId)).data.vendorId;
        allow read, write: if isAdmin(request.auth.uid);
      }

      // Uploaded Files Subcollection
      match /uploadedFiles/{fileId} {
        allow read: if request.auth.uid == get(/databases/$(database)/documents/submissions/$(docId)).data.vendorId;
        allow write: if request.auth.uid == get(/databases/$(database)/documents/submissions/$(docId)).data.vendorId;
        allow read, delete: if isAdmin(request.auth.uid);
      }
    }

    // ─── Admin Users (admin only) ───
    match /adminUsers/{uid} {
      allow read, write: if isAdmin(request.auth.uid);
    }

    // ─── Helper Functions ───
    function isAdmin(uid) {
      return exists(/databases/$(database)/documents/adminUsers/$(uid)) &&
             get(/databases/$(database)/documents/adminUsers/$(uid)).data.role in [
               'Super Admin',
               'Procurement Admin',
               'Reviewer'
             ];
    }

    function isOwner(uid) {
      return request.auth.uid == uid;
    }
  }
}
